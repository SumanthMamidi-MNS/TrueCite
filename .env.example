# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Your public hostname (e.g. truecite.duckdns.org); Caddy gets its HTTPS certificate for it.
DOMAIN=

# Which model provider answers questions: ollama (default), gemini, or anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
